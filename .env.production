# =============================================================================
# AgroConnect 2.0 — frontend/.env.production
# Variables de Entorno React + Vite para Producción (Vercel)
# =============================================================================
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  POR QUÉ LAS VARIABLES DE REACT SE INYECTAN EN BUILD TIME (NO RUNTIME)  │
# └─────────────────────────────────────────────────────────────────────────┘
#
# React (con Vite) es una Single Page Application (SPA): el servidor de Vercel
# entrega un bundle de archivos estáticos (HTML + JS + CSS), NO ejecuta código
# en el servidor por cada petición del usuario.
#
# Por esta razón, NO existe un proceso Node.js en ejecución en Vercel que pueda
# leer variables de entorno en tiempo real. En su lugar, Vite reemplaza las
# referencias a import.meta.env.VITE_* con los valores literales DURANTE la
# compilación (build time → vite build). El resultado es un archivo bundle.js
# donde "import.meta.env.VITE_API_URL" ya fue sustituido por la URL real como
# texto plano.
#
# Consecuencia práctica:
#   • Si cambias la URL del backend después de hacer el build, debes re-deployar
#     el frontend en Vercel para que el nuevo bundle incorpore la nueva URL.
#   • En Vercel Dashboard > Settings > Environment Variables, los cambios
#     solo se aplican al SIGUIENTE deploy (re-build), no al deploy actual.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PREFIJO OBLIGATORIO: VITE_                                              │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Por seguridad, Vite SOLO expone al navegador las variables que comienzan
# con el prefijo VITE_. Cualquier variable sin ese prefijo (ej: DATABASE_URL,
# JWT_SECRET) es ignorada automáticamente y nunca llega al bundle público.
#
# Uso en código React:
#   const apiUrl = import.meta.env.VITE_API_URL;
#
# =============================================================================


# =============================================================================
# CONEXIÓN AL BACKEND EXPRESS (Render)
# =============================================================================

# URL base del backend Express de AgroConnect desplegado en Render.
# REEMPLAZA con tu URL real de Render tras el primer deploy del backend.
# Formato: https://<nombre-servicio>.onrender.com/api
# Ejemplo: https://agroconnect-backend.onrender.com/api
#
# ⚠️  NO incluir trailing slash — el cliente axios/fetch lo añade en cada llamada.
# ⚠️  Copiar este mismo valor en Vercel Dashboard > Settings > Environment Variables
#     para que aplique al deploy de producción (este archivo solo aplica localmente).
VITE_API_URL=https://agroconnect-backend.onrender.com/api


# =============================================================================
# CONFIGURACIÓN DEL FRONTEND
# =============================================================================

# Nombre de la aplicación (usado en título y metaetiquetas)
VITE_APP_NAME=AgroConnect 2.0

# Versión del frontend (sincronizar con package.json)
VITE_APP_VERSION=1.0.0

# Región de operación para contexto IA y filtros de marketplace
VITE_DEFAULT_REGION=La Libertad, Perú

# Moneda local para formateo de precios
VITE_CURRENCY=PEN
VITE_CURRENCY_SYMBOL=S/.


# =============================================================================
# MAPAS — Mapbox GL JS
# =============================================================================

# Token público de Mapbox para el mapa del marketplace y tracking logístico.
# Obtener en: https://account.mapbox.com/access-tokens/
# Los tokens de Mapbox son PÚBLICOS por diseño (se usan en el browser).
# Configura restricciones de URL en el panel de Mapbox para evitar abusos.
VITE_MAPBOX_TOKEN=pk.tu-token-publico-de-mapbox-aqui


# =============================================================================
# FLAGS DE CARACTERÍSTICAS (Feature Flags)
# =============================================================================

# Activar/desactivar el chat de AgroBot en la UI
VITE_AGROBOT_ENABLED=true

# Activar modo de depuración de respuestas del agente (muestra thought_badge)
VITE_AGROBOT_DEBUG=false

# Activar mapa interactivo en el marketplace
VITE_MAP_ENABLED=true

# Activar sistema de notificaciones push
VITE_PUSH_NOTIFICATIONS_ENABLED=true


# =============================================================================
# WEBSOCKET — Tracking logístico en tiempo real
# =============================================================================

# URL del WebSocket para tracking GPS en tiempo real.
# Debe usar el mismo dominio que VITE_API_URL pero con protocolo wss://
# Ejemplo: wss://agroconnect-backend.onrender.com
VITE_WS_URL=wss://agroconnect-backend.onrender.com


# =============================================================================
# ANALYTICS (Opcional)
# =============================================================================

# ID de Google Analytics 4 (G-XXXXXXXXXX) — dejar vacío para deshabilitar
VITE_GA_MEASUREMENT_ID=


# =============================================================================
# NOTA FINAL: VARIABLES SECRETAS
# =============================================================================
# Nunca coloques en este archivo (ni en ningún .env del frontend):
#   - Claves de API privadas (Anthropic, Stripe, etc.)
#   - JWT_SECRET
#   - DATABASE_URL
#   - Cualquier secret que deba mantenerse privado
#
# Todo lo que aquí aparezca quedará visible en el bundle JS público.
# Los secrets van EXCLUSIVAMENTE en Render Dashboard > Environment.
# =============================================================================
